{
  "name": "webhid-wheel",
  "version": "0.4.37",
  "description": "Read USB HID steering wheels in the browser over WebHID — steering, buttons, pedals and force feedback. ESM library + UI components + demo.",
  "type": "module",
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./webhid-wheel.js": {
      "types": "./webhid-wheel.d.ts",
      "import": "./webhid-wheel.js",
      "default": "./webhid-wheel.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/ui/index.js"
  ],
  "files": [
    "dist",
    "src",
    "docs",
    "webhid-wheel.js",
    "webhid-wheel.d.ts",
    "readme.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "test:ui": "playwright test",
    "prepare": "npm run build"
  },
  "keywords": [
    "webhid",
    "hid",
    "steering-wheel",
    "racing-wheel",
    "gamepad",
    "force-feedback",
    "ffb",
    "browser",
    "web-components"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
